{
  "tools_list": [
    {
      "name": "login",
      "description": "使用账号和密码登录聊天服务，登录后可持续收发消息。"
    },
    {
      "name": "send_message",
      "description": "向用户或已有群发送一条文本消息。"
    },
    {
      "name": "receive_messages",
      "description": "查看当前账号收到的新消息。"
    }
  ],
  "tools": {
    "login": {
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "description": "登录账号"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true,
            "description": "登录密码"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "successful": {
            "type": "boolean",
            "description": "是否登录成功"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "登录结果说明或失败原因"
          }
        },
        "required": [
          "successful",
          "message"
        ]
      }
    },
    "send_message": {
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string",
            "description": "收件人的账号名、服务侧配置的联系人名称，或实际用户、已有群 ID"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "发送的文本内容"
          }
        },
        "required": [
          "target",
          "content"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "successful": {
            "type": "boolean",
            "description": "操作是否成功"
          },
          "message": {
            "type": "string",
            "description": "操作结果说明"
          },
          "status": {
            "type": "string",
            "enum": [
              "sent",
              "failed",
              "unknown"
            ],
            "description": "sent 表示聊天服务已接受；failed 表示未完成；unknown 表示无法确认，请先检查聊天记录，避免重复发送"
          },
          "message_id": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "description": "发送成功时服务端返回的消息标识"
          }
        },
        "required": [
          "successful",
          "message",
          "status"
        ]
      },
      "notes": [
        "先登录一次，后续发送无需再次提供账号密码。",
        "目标群需要已经存在并具有发言权限。",
        "发送成功不表示对方已收到或阅读。",
        "同一聊天服务器的账号在本工具成功登录后，会自动登记账号名；其他联系人和群名称由 ChatService 配置。"
      ]
    },
    "receive_messages": {
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "description": "可选的账号名、联系人名称或用户、群 ID；不填则收取已有会话的消息"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "本次最多收取的消息条数"
          }
        },
        "required": []
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "successful": {
            "type": "boolean",
            "description": "操作是否成功"
          },
          "message": {
            "type": "string",
            "description": "操作结果说明"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "message_id": {
                  "type": "string",
                  "description": "消息标识，可用于识别重复消息"
                },
                "sender": {
                  "type": "string",
                  "description": "发送者；已配置的联系人显示名称，否则显示实际用户 ID"
                },
                "target": {
                  "type": "string",
                  "description": "所属聊天对象；已配置时显示名称，否则显示实际会话 ID"
                },
                "content": {
                  "type": "string",
                  "description": "消息正文"
                },
                "timestamp": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null,
                  "description": "发送时间"
                }
              },
              "required": [
                "message_id",
                "sender",
                "target",
                "content"
              ]
            },
            "default": [],
            "description": "收到的消息；没有新消息时为空列表"
          }
        },
        "required": [
          "successful",
          "message"
        ]
      },
      "notes": [
        "首次收取可能包含聊天服务中已有的历史消息。",
        "正常连续调用会推进收件进度；ChatService 所在宿主进程重启或响应丢失时可能重现消息，可按 message_id 去重。",
        "这里只返回其他人或系统发来的消息，不包含自己发送的消息。"
      ]
    }
  }
}
