# BIND API runtime settings.
DEBUG_MODE=false
API_HOST=__ADDRESS__
API_PORT=7650
WORKER_NUM=1
LOG_FILE=/var/log/bind9-api/api.log
PID_FILE=/run/bind9-api/api.pid
BACKUP_DIR=/var/lib/bind9-api/backups
BIND9_ZONE_DIR=/etc/bind/api-zones
BIND9_CONF_FILE=/etc/bind/bind9-api.conf
BIND9_MAIN_CONF=/etc/bind/named.conf
BIND9_SLAVE_DIR=/var/cache/bind
RNDC_BIN=/usr/sbin/rndc
NAMED_CHECKCONF_BIN=/usr/bin/named-checkconf
NAMED_CHECKZONE_BIN=/usr/bin/named-checkzone
BIND9_VALIDATE=true
SOA_EMAIL=hostmaster.__DOMAIN__.
REFRESH=300
RETRY=60
EXPIRE=1209600
MIN_TTL=300
NS1=ns1.__DOMAIN__.
NS2=ns2.__DOMAIN__.
DB_TYPE=sqlite
DB_DATABASE=/var/lib/bind9-api/bind9_api.sqlite
DB_BUSY_TIMEOUT=5000
SESSION_TTL=3600
SESSION_BIND_IP=true
TRUSTED_PROXIES=
RATELY=true
LOGIN_RATE_LIMIT=30
RATE_LIMIT=120
RATE_PERIOD=60
