# Application image; scenario configuration is mounted by its Bundle.
FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
# Bootstrap CA certificates over signed APT metadata, then use HTTPS.
RUN sed -i -e 's|http://archive.ubuntu.com/ubuntu/\?|http://mirrors.ustc.edu.cn/ubuntu/|g' -e 's|http://security.ubuntu.com/ubuntu/\?|http://mirrors.ustc.edu.cn/ubuntu/|g' -e 's|http://ports.ubuntu.com/ubuntu-ports/\?|http://mirrors.ustc.edu.cn/ubuntu-ports/|g' /etc/apt/sources.list.d/ubuntu.sources && apt-get -o Acquire::Retries=0 -o Acquire::http::Timeout=30 update && apt-get -o Acquire::Retries=0 -o Acquire::http::Timeout=30 install -y --no-install-recommends ca-certificates && sed -i 's|http://mirrors.ustc.edu.cn/|https://mirrors.ustc.edu.cn/|g' /etc/apt/sources.list.d/ubuntu.sources
RUN apt-get -o Acquire::Retries=0 -o Acquire::https::Timeout=30 update && apt-get -o Acquire::Retries=0 -o Acquire::https::Timeout=30 install -y --no-install-recommends bind9-dnsutils ca-certificates cron curl iproute2 iputils-ping mariadb-client mariadb-server nginx openssl python3 software-properties-common unzip
RUN mkdir -p /usr/share/keyrings && curl -fLsS --connect-timeout 10 --max-time 60 https://ppa.setup-php.com/keys/ondrej/php.gpg -o /usr/share/keyrings/ondrej-php.gpg && echo '46865863bccffcf614bf1c8603492c6a5465dcc8d774f0020e7518378ba53466  /usr/share/keyrings/ondrej-php.gpg' | sha256sum -c - && . /etc/os-release && printf 'deb [signed-by=/usr/share/keyrings/ondrej-php.gpg] https://ppa.setup-php.com/ondrej/php/ubuntu/ %s main\n' "$VERSION_CODENAME" > /etc/apt/sources.list.d/ondrej-php.list
RUN apt-get -o Acquire::CompressionTypes::Order=xz -o Acquire::Retries=0 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=0 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y php8.5-cli php8.5-fpm php8.5-mysql php8.5-curl php8.5-gd php8.5-intl php8.5-mbstring php8.5-xml php8.5-zip php8.5-bcmath php8.5-gmp php8.5-imap
RUN mkdir -p /var/www/fossbilling && curl --connect-timeout 30 -fsSL https://github.com/FOSSBilling/FOSSBilling/releases/download/0.8.7/FOSSBilling-0.8.7.zip -o /tmp/fossbilling.zip && unzip -q /tmp/fossbilling.zip -d /var/www/fossbilling && chown -R www-data:www-data /var/www/fossbilling
RUN curl --connect-timeout 30 -fsSL https://raw.githubusercontent.com/getnamingo/fossbilling-epp-registrar/018911b170ee5c5542d4f29ce6e60fbb1192e95a/install-fossbilling-epp.sh -o /tmp/install-fossbilling-epp.sh && bash /tmp/install-fossbilling-epp.sh namingo /var/www/fossbilling
RUN curl --connect-timeout 30 -fsSL https://github.com/getnamingo/fossbilling-dns/releases/download/v1.2.7/fossbilling-dns-v1.2.7.tar.gz -o /tmp/fossbilling-dns.tar.gz && echo '8b6171b985c0bae005550f3c2fac752f9c7ccfb4f3f752d62a6920adc68160de  /tmp/fossbilling-dns.tar.gz' | sha256sum -c - && tar -xzf /tmp/fossbilling-dns.tar.gz -C /var/www/fossbilling/modules --strip-components=1 fossbilling-dns-v1.2.7/Servicedns && chown -R www-data:www-data /var/www/fossbilling/modules/Servicedns && rm /tmp/fossbilling-dns.tar.gz
COPY patch-checkout-order-activation.php /opt/fossbilling/patch-checkout-order-activation.php
RUN php8.5 /opt/fossbilling/patch-checkout-order-activation.php && php8.5 -l /var/www/fossbilling/modules/Cart/Service.php
RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf && rm -rf /var/lib/apt/lists/*
EXPOSE 8080
CMD ["sleep", "infinity"]
