MC_HOST=host.docker.internal
# Fill in the port shown after opening your Java 26.1 world to LAN.
MC_PORT=
MC_AUTH=offline
# For online-mode servers use MC_AUTH=microsoft and the account identifier here.
MC_READY_TIMEOUT_SECONDS=180

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
AGENT_ROUNDS=10
AGENT_MAX_STEPS=20
AGENT_INTERVAL_SECONDS=10
AGENT_START_DELAY_SECONDS=0
AGENT_READY_TIMEOUT_SECONDS=0

# Minecraft username for each agent; no shared username fallback.
MC_ALICE_USERNAME=Alice
MC_BOB_USERNAME=Bob
# Optional per-agent auth overrides: MC_<NAME>_AUTH



MC_CAROL_USERNAME=Carol

MC_DAVE_USERNAME=Dave

MC_EVE_USERNAME=Eve

# Chat notification radius in blocks at receipt; unknown sender positions are excluded.
MC_CHAT_RADIUS=32
